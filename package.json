{
  "name": "new-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:routes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-routes.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:messages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-messages.mjs",
    "start": "next start",
    "check:navigation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-navigation.mjs",
    "check:dead": "node scripts/check-dead.mjs",
    "check:hardcoded": "node scripts/check-hardcoded.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:untranslated": "node scripts/check-untranslated.mjs",
    "check:build": "node scripts/build-clean.mjs",
    "check:assets": "node scripts/check-assets.mjs",
